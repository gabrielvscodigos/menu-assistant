# Copy to .env and adjust. All variables are optional; defaults are shown.

# Directory where ChromaDB persists the menu index.
MENU_ASSISTANT_CHROMA_PATH=.chroma

# ChromaDB collection holding the indexed dishes.
MENU_ASSISTANT_COLLECTION_NAME=menu

# sentence-transformers model used to embed dishes and queries.
# Changing the model or document prefix requires re-running ingestion.
MENU_ASSISTANT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
MENU_ASSISTANT_EMBEDDING_QUERY_PREFIX="query: "
MENU_ASSISTANT_EMBEDDING_DOCUMENT_PREFIX="passage: "

# Ranking bonus per dish tag named in the query (0 disables). See docs/evaluation.md.
MENU_ASSISTANT_TAG_BOOST=0.05
